# Copy to .env and fill in real values. Never commit .env.
# Required only for --live-model runs.
OPENROUTER_API_KEY=

# Optional OpenRouter app attribution.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Optional OpenRouter provider routing (see openrouter.ai/docs/guides/routing/provider-selection)
# OPENROUTER_PROVIDER_ORDER=
# OPENROUTER_PROVIDER_ONLY=
OPENROUTER_PROVIDER_ONLY_DEEPSEEK=baidu/fp8,deepinfra/fp4
# OPENROUTER_PROVIDER_SORT=price
# OPENROUTER_PROVIDER_ALLOW_FALLBACKS=true
OPENROUTER_EXPENSIVE_PROVIDERS=alibaba,morph,parasail/fp8

# Optional overrides (see config.toml for the same keys).
# Recommended: Sonnet parent + Haiku reviewer; flash Coder; lite read-only roles.
VG_PARENT_MODEL=openrouter/anthropic/claude-sonnet-4.6
VG_GRILLING_MODEL=google/gemini-2.5-flash-lite
VG_EXPLORER_MODEL=google/gemini-2.5-flash-lite
VG_CODER_MODEL=google/gemini-2.5-flash
VG_REVIEWER_MODEL=openrouter/anthropic/claude-haiku-4.5
VG_COMPACTOR_MODEL=google/gemini-2.5-flash-lite
# Budget caps (read at startup; no regenerate needed). Per-run USD ceiling,
# rolling daily USD ceiling, and per-run token ceiling. The preflight reserves
# worst-case input+output before each model call and aborts with usd_cap /
# daily_cap / token_cap if a call would exceed these.
VG_MAX_USD_PER_RUN=0.50
VG_MAX_USD_PER_DAY=5.00
VG_MAX_TOKENS_PER_RUN=80000
# Approval gating mode: off | writes | all. "writes" prompts before file
# writes/edits and bash; "all" also gates reads; "off" runs unattended.
VG_APPROVAL_MODE=writes
# Tool-result compaction threshold (token estimate); default 4000.
VG_K_COMPACT=4000
# Per-turn output token cap for the parent model loop; default 4096.
# Raise only if the parent must emit large payloads (e.g. big file writes) in
# one turn — note the budget preflight reserves this many output tokens, so a
# larger value trips token/usd/daily caps earlier. Ignored if <= 0.
VG_MAX_OUTPUT_TOKENS=4096
# Exit at startup if any VG_*_MODEL lacks local pricing (default: warn only).
# VG_STRICT_MODEL_PRICING=1
